# DevOps Git Configuration
# Practical settings for DevOps work

[user]
	# Set your name and email
	# name = Your Name
	# email = your.email@example.com

[core]
	# Use vim as default editor
	editor = vim
	
	# Enable color output
	color.ui = auto
	
	# Set line ending handling
	autocrlf = input
	eol = lf
	
	# Set file mode
	filemode = true
	
	# Set ignore case
	ignorecase = false
	
	# Set precompose unicode
	precomposeunicode = true
	
	# Set quote path
	quotepath = false
	
	# Set whitespace handling
	whitespace = trailing-space,space-before-tab
	
	# Set pager
	pager = less -FRX

[push]
	# Set default push behavior
	default = simple
	
	# Set auto setup remote
	autoSetupRemote = true

[pull]
	# Set default pull behavior
	default = current
	
	# Set rebase behavior
	rebase = false

[merge]
	# Set merge tool
	tool = vimdiff
	
	# Set conflict style
	conflictstyle = diff3

[diff]
	# Set diff tool
	tool = vimdiff
	
	# Set color output
	colorMoved = zebra
	
	# Set algorithm
	algorithm = patience

[status]
	# Set status output
	showUntrackedFiles = all
	
	# Set branch output
	branch = true

[log]
	# Set log format
	date = short
	
	# Set decoration
	decorate = short
	
	# Set graph
	graph = true

[alias]
	# Basic aliases
	st = status
	co = checkout
	br = branch
	ci = commit
	df = diff
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD
	visual = !gitk
	
	# Status aliases
	s = status --short --branch
	ss = status --short
	
	# Commit aliases
	cm = commit -m
	ca = commit -a
	cam = commit -am
	amend = commit --amend
	
	# Branch aliases
	b = branch
	ba = branch -a
	bd = branch -d
	bD = branch -D
	bm = branch -m
	br = branch -r
	
	# Checkout aliases
	co = checkout
	cob = checkout -b
	com = checkout main
	cod = checkout develop
	
	# Merge aliases
	m = merge
	mn = merge --no-ff
	ms = merge --squash
	
	# Rebase aliases
	rb = rebase
	ri = rebase -i
	rc = rebase --continue
	ra = rebase --abort
	rs = rebase --skip
	
	# Stash aliases
	sa = stash apply
	sc = stash clear
	sd = stash drop
	sl = stash list
	sp = stash pop
	sts = stash save
	sw = stash show
	
	# Remote aliases
	rem = remote
	ra = remote add
	rr = remote remove
	rv = remote -v
	ru = remote update
	rp = remote prune
	
	# Fetch aliases
	f = fetch
	fa = fetch --all
	fp = fetch --prune
	
	# Pull aliases
	p = pull
	pr = pull --rebase
	pt = pull --tags
	
	# Push aliases
	pu = push
	pum = push origin main
	pud = push origin develop
	put = push --tags
	puu = push -u origin HEAD
	
	# Log aliases
	l = log --oneline
	ll = log --oneline --graph --decorate --all
	lf = log --follow
	lp = log --patch
	ls = log --stat
	l1 = log -1
	l5 = log -5
	l10 = log -10
	
	# Show aliases
	sh = show
	shs = show --stat
	shp = show --patch
	
	# Diff aliases
	d = diff
	dc = diff --cached
	dh = diff HEAD
	d1 = diff HEAD~1
	d2 = diff HEAD~2
	d3 = diff HEAD~3
	
	# Reset aliases
	rst = reset
	rh = reset --hard
	rsoft = reset --soft
	rm = reset --mixed
	
	# Clean aliases
	cl = clean
	clf = clean -f
	cld = clean -fd
	
	# Tag aliases
	t = tag
	ta = tag -a
	td = tag -d
	tl = tag -l
	
	# Config aliases
	cf = config
	cfl = config --list
	cfg = config --global
	cflocal = config --local
	
	# DevOps specific aliases
	# Docker
	docker-log = log --oneline --grep="docker"
	docker-commit = commit -m "docker: "
	
	# Kubernetes
	k8s-log = log --oneline --grep="k8s"
	k8s-commit = commit -m "k8s: "
	
	# Terraform
	tf-log = log --oneline --grep="terraform"
	tf-commit = commit -m "terraform: "
	
	# AWS
	aws-log = log --oneline --grep="aws"
	aws-commit = commit -m "aws: "
	
	# CI/CD
	ci-log = log --oneline --grep="ci"
	ci-commit = commit -m "ci: "
	
	# Security
	sec-log = log --oneline --grep="security"
	sec-commit = commit -m "security: "
	
	# Bug fixes
	fix-log = log --oneline --grep="fix"
	fix-commit = commit -m "fix: "
	
	# Features
	feat-log = log --oneline --grep="feat"
	feat-commit = commit -m "feat: "
	
	# Documentation
	docs-log = log --oneline --grep="docs"
	docs-commit = commit -m "docs: "
	
	# Refactoring
	refactor-log = log --oneline --grep="refactor"
	refactor-commit = commit -m "refactor: "
	
	# Performance
	perf-log = log --oneline --grep="perf"
	perf-commit = commit -m "perf: "
	
	# Tests
	test-log = log --oneline --grep="test"
	test-commit = commit -m "test: "
	
	# Chores
	chore-log = log --oneline --grep="chore"
	chore-commit = commit -m "chore: "

[init]
	# Set default branch
	defaultBranch = main

[fetch]
	# Set prune behavior
	prune = true
	
	# Set prune tags
	pruneTags = true

[rebase]
	# Set auto stash
	autoStash = true
	
	# Set auto squash
	autoSquash = true

[rerere]
	# Enable rerere
	enabled = true
	
	# Set auto update
	autoUpdate = true

[help]
	# Set help format
	format = man

[advice]
	# Disable push update
	pushUpdateRejected = false
	
	# Disable push non fast forward
	pushNonFastForward = false
	
	# Disable status hints
	statusHints = false
	
	# Disable status untracked files
	statusUntrackedFiles = false

[color]
	# Set color for different outputs
	branch = auto
	diff = auto
	status = auto
	ui = auto
	
	# Set color for specific commands
	[color "branch"]
		current = yellow reverse
		local = green
		remote = red
	
	[color "diff"]
		meta = yellow bold
		frag = magenta bold
		old = red bold
		new = green bold
	
	[color "status"]
		added = yellow
		changed = green
		untracked = cyan

[filter]
	# Set lfs filter
	[filter "lfs"]
		clean = git-lfs clean -- %f
		smudge = git-lfs smudge -- %f
		process = git-lfs filter-process
		required = true

[include]
	# Include local configuration if it exists
	path = ~/.gitconfig.local